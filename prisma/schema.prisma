generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Machine {
  id              Int           @id @default(autoincrement())
  title           String
  slug            String        @unique
  manufacturer    String
  category        String
  model           String?
  serialNumber    String?
  condition       Condition     @default(USED)
  quantity        Int           @default(1)
  description     String
  price           Decimal?      @db.Decimal(10, 2)
  callForPrice    Boolean       @default(false)
  status          ListingStatus @default(DRAFT)
  featured        Boolean       @default(false)
  specs           Json?
  images          Json?         // [{cloudinaryId, altText, sortOrder}]
  dateListed      DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  soldAt          DateTime?
  soldTo          String?
  salePrice       Decimal?      @db.Decimal(10, 2)
  soldNotes       String?
  contactEmail    String?
  contactPhone    String?
  contactNote     String?
  metaDescription String?
  views           Int      @default(0)
  sales           Sale[]

  @@index([status, dateListed])
  @@index([featured, status])
}

/// One recorded sale. Kept separate from Machine so the sales history survives
/// a listing being edited or deleted, and so a listing with quantity > 1 can be
/// sold off across several transactions.
model Sale {
  id           Int      @id @default(autoincrement())
  machineId    Int?
  machine      Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)

  /// Copied from the listing at the time of sale so the report stays accurate
  /// even if the listing is later renamed or removed.
  itemTitle    String
  manufacturer String
  category     String

  quantity     Int      @default(1)
  /// Total received for this sale, not a per-unit price.
  salePrice    Decimal? @db.Decimal(10, 2)
  buyerName    String
  buyerEmail   String?
  notes        String?
  soldAt       DateTime @default(now())

  @@index([soldAt])
  @@index([machineId])
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userEmail  String
  userName   String
  action     String
  entityType String
  entityId   Int?
  entityName String?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model ContactInquiry {
  id          Int      @id @default(autoincrement())
  machineId   Int?
  machineName String?
  name        String
  email       String
  phone       String?
  message     String
  createdAt   DateTime @default(now())
  read        Boolean  @default(false)
}

model WantedItem {
  id           Int          @id @default(autoincrement())
  title        String
  manufacturer String
  category     String
  description  String
  status       WantedStatus @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model NewsletterSubscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscribedAt DateTime @default(now())
  active       Boolean  @default(true)
}

enum Condition {
  NEW
  USED
  REFURBISHED
  PARTS_ONLY
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PENDING
  SOLD
}

enum WantedStatus {
  ACTIVE
  CLOSED
}
